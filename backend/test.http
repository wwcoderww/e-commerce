@baseUrl = https://e-commerce-backend-wnhs.onrender.com
@localHost = http://localhost:8080

### /history POST
POST {{localHost}}/history
Accept: application/json
Content-Type: application/json

{   
  "userId": "uRBfHHNCWUm8uPKKuhMiVcSac4vhfZtK",
  "purchases": [
    {
      "name": "a",
      "price": 1,
      "quantity": 1,
      "productId": "e30dc6d0-ef3a-446d-83bb-0ef6990e7acc"
    },
    {
      "name": "b",
      "price": 2,
      "quantity": 2,
      "productId": "c9f0b9a5-a10b-4f06-877a-9014e51a0f1a"
    }
  ],
  "customerInfo": {
    "email": "test@example.com",
    "firstName": "John",
    "lastName": "Doe",
    "address": "123 Main St",
    "address2": "",
    "city": "Houston",
    "state": "TX",
    "zip": "77001",
    "country": "USA"
  }
}

### /hitory GET
GET {{localHost}}/history/e97d7879-9d74-47a9-98d6-d8aa0fe2e98e
Accept: application/json

### /hitory/purchases GET
GET {{localHost}}/history/purchases
Accept: application/json

### Render - GET CART Admin user
GET {{baseUrl}}/api/cart/4GWQpWwDGAPE18GQ6gABZvauNRSxFlY8
Accept: application/json

### Render - POST CART Item
POST {{baseUrl}}/api/cart
Accept: application/json
Content-Type: application/json

{
    "userId": "4GWQpWwDGAPE18GQ6gABZvauNRSxFlY8",
    "productId": 24
}

### Render - PUT CART Item +1
PUT {{baseUrl}}/api/cart
Accept: application/json
Content-Type: application/json

{
    "userId": "4GWQpWwDGAPE18GQ6gABZvauNRSxFlY8",
    "productId": 24,
    "quantity": 1
}
### Render - PUT CART Item -1
PUT {{baseUrl}}/api/cart
Accept: application/json
Content-Type: application/json

{
    "userId": "4GWQpWwDGAPE18GQ6gABZvauNRSxFlY8",
    "productId": 24,
    "quantity": -1
}

### Render - Delete CART Item
DELETE {{baseUrl}}/api/cart
Accept: application/json
Content-Type: application/json

{
    "userId": "4GWQpWwDGAPE18GQ6gABZvauNRSxFlY8",
    "productId": 24
}

### Render - GET All Products
GET https://e-commerce-backend-wnhs.onrender.com/api/products
Accept: application/json
User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
